# Replace placeholders locally; never commit .env. No dotenv auto-loading in the library.
PARALLAX_ENVIRONMENT=development
PARALLAX_LOG_LEVEL=INFO
PARALLAX_DEFAULT_SEED=0
# Compose uses host postgres. Local CLI/API use localhost with a separately hosted database.
PARALLAX_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@postgres:5432/parallax_risk
POSTGRES_USER=REPLACE_USER
POSTGRES_PASSWORD=REPLACE_PASSWORD
POSTGRES_DB=parallax_risk
